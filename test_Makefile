FLAGS = -Wall -Wextra -g

all: test_all

io_utils.o: io_utils.c io_utils.h protocol.h
	gcc ${FLAGS} -c io_utils.c

model.o: model.c model.h
	gcc ${FLAGS} -c model.c

server_funcs.o: server.c protocol.h io_utils.h model.h
	gcc ${FLAGS} -c server.c -o server_funcs.o

worker_funcs.o: worker.c protocol.h io_utils.h model.h
	gcc ${FLAGS} -Wno-unused-function -c worker.c -o worker_funcs.o

test_io_utils: test_io_utils.c io_utils.o
	gcc ${FLAGS} -o test_io_utils test_io_utils.c io_utils.o

test_model: test_model.c model.o
	gcc ${FLAGS} -o test_model test_model.c model.o -lm

test_server: test_server.c server_funcs.o io_utils.o model.o
	gcc ${FLAGS} -o test_server test_server.c server_funcs.o io_utils.o model.o -lm

test_worker: test_worker.c worker_funcs.o server_funcs.o io_utils.o model.o
	gcc ${FLAGS} -o test_worker test_worker.c worker_funcs.o server_funcs.o io_utils.o model.o -lm

test_all: test_io_utils test_model test_server test_worker
	@echo "=== Running all tests ==="
	@echo ""
	@./test_io_utils
	@echo ""
	@./test_model
	@echo ""
	@./test_server
	@echo ""
	@./test_worker
	@echo ""
	@echo "=== All test suites complete ==="

clean:
	rm -f test_io_utils test_model test_server test_worker
	rm -f io_utils.o model.o server_funcs.o worker_funcs.o
